load("//tools/lint:lint.bzl", "add_lint_tests")
load("//tools/skylark:cc.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Shared infrastructure header (no compiled code)
# ---------------------------------------------------------------------------

cc_library(
    name = "gpu_env_common",
    hdrs = ["gpu_env_common.h"],
    copts = ["-std=c++17"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# GPU-parallel environments — CPU build (no CUDA required)
# ---------------------------------------------------------------------------

cc_library(
    name = "gpu_environments",
    srcs = [
        "gpu_parallel_cartpole_env.cc",
        "gpu_parallel_pendulum_env.cc",
        "gpu_parallel_mountaincar_env.cc",
    ],
    hdrs = [
        "gpu_env_common.h",
        "gpu_parallel_cartpole_env.h",
        "gpu_parallel_pendulum_env.h",
        "gpu_parallel_mountaincar_env.h",
    ],
    copts = ["-std=c++17"],
    deps = [],
)

# Backwards-compat alias.
cc_library(
    name = "gpu_parallel_cartpole_env",
    deps = [":gpu_environments"],
)

# ---------------------------------------------------------------------------
# GPU-parallel environments — CUDA build
#
# Build with:
#   bazel build //gpu_environments:gpu_environments_cuda \
#       --define=drake_gpu=true
#
# Requires: CUDA 11.8+, NVIDIA GPU with compute capability >= 7.0.
# ---------------------------------------------------------------------------

cc_library(
    name = "gpu_environments_cuda",
    srcs = [
        "gpu_parallel_cartpole_env.cc",
        "gpu_parallel_pendulum_env.cc",
        "gpu_parallel_mountaincar_env.cc",
        # .cu files must be pre-compiled with nvcc and provided as cc_import.
    ],
    hdrs = [
        "gpu_env_common.h",
        "gpu_parallel_cartpole_env.h",
        "gpu_parallel_pendulum_env.h",
        "gpu_parallel_mountaincar_env.h",
    ],
    copts = [
        "-std=c++17",
        "-DDRAKE_GPU_AVAILABLE",
    ],
    linkopts = [
        "-lcuda",
        "-lcudart",
    ],
    tags = ["manual"],
    deps = [],
)

add_lint_tests(enable_clang_format_lint = False)
