load("//tools/skylark:cc.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

# ---------------------------------------------------------------------------
# CartPole 128-environment test — CPU build
# ---------------------------------------------------------------------------
cc_test(
    name = "gpu_parallel_128_test",
    size = "small",
    srcs = ["gpu_parallel_128_test.cc"],
    deps = ["//gpu_environments:gpu_environments"],
)

# ---------------------------------------------------------------------------
# Pendulum 128-environment test — CPU build
# ---------------------------------------------------------------------------
cc_test(
    name = "gpu_parallel_pendulum_128_test",
    size = "small",
    srcs = ["gpu_parallel_pendulum_128_test.cc"],
    deps = ["//gpu_environments:gpu_environments"],
)

# ---------------------------------------------------------------------------
# GPU/CUDA variants (require CUDA 11.8+ and NVIDIA device)
# ---------------------------------------------------------------------------
cc_test(
    name = "gpu_parallel_128_test_cuda",
    size = "small",
    srcs = ["gpu_parallel_128_test.cc"],
    copts = ["-DDRAKE_GPU_AVAILABLE"],
    tags = ["manual"],
    deps = ["//gpu_environments:gpu_environments_cuda"],
)

cc_test(
    name = "gpu_parallel_pendulum_128_test_cuda",
    size = "small",
    srcs = ["gpu_parallel_pendulum_128_test.cc"],
    copts = ["-DDRAKE_GPU_AVAILABLE"],
    tags = ["manual"],
    deps = ["//gpu_environments:gpu_environments_cuda"],
)
